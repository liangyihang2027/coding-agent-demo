# 复制为 .env 并填入你的配置

# ── Provider 选择 ──────────────────────────────────────────
# openai  = 本地 Agent 循环 + OpenAI 兼容 LLM（默认）
# cursor  = Cursor Cloud Agents SDK（使用 CURSOR_API_KEY）
LLM_PROVIDER=cursor

# ── OpenAI 兼容 provider（LLM_PROVIDER=openai 时使用）──────
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Cursor Cloud Agents（LLM_PROVIDER=cursor 时使用）───────
# 在 https://cursor.com/dashboard/api 创建
CURSOR_API_KEY=crsr_xxxx
CURSOR_MODEL=composer-2

# local = 在当前 cwd 运行（默认）；cloud = 在 Cursor 云端 VM 操作 GitHub 仓库
CURSOR_RUNTIME=local

# 可选：ripgrep 路径（未设置时自动探测 SDK 自带的 rg）
# CURSOR_RIPGREP_PATH=/absolute/path/to/rg

# 仅 cloud 模式需要：
# CURSOR_REPO_URL=https://github.com/your-org/your-repo
# CURSOR_STARTING_REF=main
# CURSOR_AUTO_CREATE_PR=false
